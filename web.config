<configuration>
<system.webServer>


        <defaultDocument>
            <files>
                <add value="app.js" />
            </files>
        </defaultDocument>
        <rewrite>
            <rules>
                <rule name="iistonode">
                    <match url="/*"  />
                    <action type="Rewrite" url="app.js" />
                </rule>
            </rules>
        </rewrite>
</system.webServer>



 </configuration>
