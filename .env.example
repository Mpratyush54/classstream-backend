# Copy to .env for LOCAL dev only. Production values stay on the server — never commit .env.
# MySQL (local dev)
host=localhost
user=root
password=
database=school

# MongoDB (local dev)
MONGO_URI=mongodb://127.0.0.1:27017/school_dev?authSource=admin

# JWT/Crypto Secrets — local dummy only. Server uses its own strong values.
crypto=LOCAL_DEV_ONLY_REPLACE_ME_1234567890
refresh_token=LOCAL_DEV_ONLY_REPLACE_ME_0987654321

# OpenAI (optional, leave blank to skip AI routes)
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Web Push VAPID (optional)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
